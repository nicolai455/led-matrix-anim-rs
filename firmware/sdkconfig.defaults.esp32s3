CONFIG_IDF_TARGET="esp32s3"
# Candidate supervisor (ESP-IDF main task) stack size, in bytes.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16MB.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# N16R8: 16 MB quad-SPI flash and 8 MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Reserve internal-capable memory for native service/task stacks after Wi-Fi
# and parallel DMA initialization; PSRAM cannot satisfy those allocations.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Four fewer static Wi-Fi TX buffers save approximately 6.4 KB internal RAM.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=12

# Keep the I2S GDMA callback context in internal RAM, as required by the
# IRAM-safe GDMA interrupt used by LCD output.
CONFIG_I2S_ISR_IRAM_SAFE=y
# Refill LED data even while flash cache is unavailable.
CONFIG_RMT_ISR_IRAM_SAFE=y

# The board's native USB port carries both flashing and boot diagnostics.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
